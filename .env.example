# ============================================================
# ENVIRONMENT VARIABLES - ÖRNEK DOSYA
# ============================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyası asla Git'e commit edilmemelidir!
# ============================================================

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development           # production / development
SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=True

# Application Settings
APP_HOST=127.0.0.1
APP_PORT=5000

# Model Settings
MODEL_PATH=models/trained/best_model.pkl
SCALER_PATH=models/trained/scaler.pkl

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
