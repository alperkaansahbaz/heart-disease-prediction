# ============================================================
# HEART DISEASE PREDICTION - GIT IGNORE
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
develop-eggs/
.eggs/

# ---------- Virtual Environments ----------
venv/
env/
ENV/
.venv/
.env
.envrc

# ---------- IDE & Editors ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- Testing & Coverage ----------
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# ---------- Flask ----------
instance/
.webassets-cache
flask_session/

# ---------- Machine Learning ----------
# Eğitilmiş modelleri repo'ya koymuyoruz (büyük dosyalar)
# Bunun yerine eğitim scripti ile yeniden üretilebilir olmalı
models/trained/*.pkl
models/trained/*.joblib
models/trained/*.h5
!models/trained/.gitkeep

# ---------- Data Files ----------
# Ham ve işlenmiş veri repo'ya eklenmez (lisans/boyut/kişisel veri)
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!data/raw/README.md

# CSV/Excel dosyaları (genel kural)
*.csv
*.xlsx
*.xls
!tests/fixtures/*.csv         # Test fixture'larına izin ver

# ---------- Logs ----------
*.log
logs/
*.log.*

# ---------- OS Generated ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---------- Secrets & Configs ----------
*.pem
*.key
secrets.json
config_local.py

# ---------- Reports (Geçici çıktılar) ----------
reports/figures/*.png
reports/figures/*.jpg
!reports/figures/.gitkeep
